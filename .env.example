# ── Database ────────────────────────────────────────────────────────────────
# Async SQLAlchemy URL.
# SQLite (default, dev only):
DATABASE_URL=sqlite+aiosqlite:///./classiflow.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/classiflow

# ── JWT authentication ───────────────────────────────────────────────────────
# Minimum 32 random bytes (RFC 7518 §3.2 for HS256).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Token lifetime in minutes (default: 60).
JWT_EXPIRE_MINUTES=60

# ── Weights & Biases (LLM tracing) ───────────────────────────────────────────
# Setting WANDB_API_KEY is what enables tracing -- leave it empty (the default) and
# no tracer is attached, weave.init() is never called, and no network requests are
# made, so tests and clones without a key behave exactly as before.
# Get yours from https://wandb.ai/authorize
WANDB_API_KEY=

# W&B project every LLM trace is logged under. Defaults to "classiflow" if unset.
WANDB_PROJECT=classiflow

# Read by weave, not by this app. Left at "false" so weave doesn't register its own
# global LangChain tracer, which raises on llama.cpp's None metadata fields and leaves
# traces unfinished; the app attaches a patched tracer instead. Set to "true" only to
# debug weave's own tracing behaviour.
WEAVE_TRACE_LANGCHAIN=false

# ── Knowledge base (stage 5) ─────────────────────────────────────────────────
# Persistent ChromaDB directory. Gitignored via data/.
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=classiflow_docs

# Retrieval embedder. Multilingual on purpose -- the corpus is Spanish.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5

# ── Chat agent ───────────────────────────────────────────────────────────────
CHAT_MAX_TOKENS=2048

# Needs more context than the validation nodes: retrieved passages + question +
# answer.
CHAT_MODEL_N_CTX=8192

GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret

# Where Google redirects after sign-in -- the frontend's OAuth popup route (not the
# backend's own /auth/callback). Default matches the Vite dev server's default port.
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth-popup
