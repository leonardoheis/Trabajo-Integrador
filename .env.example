# ── Database ────────────────────────────────────────────────────────────────
# Async SQLAlchemy URL.
# SQLite (default, dev only):
DATABASE_URL=sqlite+aiosqlite:///./classiflow.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/classiflow

# ── JWT authentication ───────────────────────────────────────────────────────
# Minimum 32 random bytes (RFC 7518 §3.2 for HS256).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Token lifetime in minutes (default: 60).
JWT_EXPIRE_MINUTES=60

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ── Knowledge base (stage 5) ─────────────────────────────────────────────────
# Persistent ChromaDB directory. Gitignored via data/.
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=classiflow_docs

# Retrieval embedder. Multilingual on purpose -- the corpus is Spanish.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5

# Folder holding the municipal CSVs used to resolve document metadata and
# download links.
SCRAPPER_DIR=./scrapper

# ── Chat agent ───────────────────────────────────────────────────────────────
# "llama" (local GGUF, offline) or "claude" (Anthropic API).
CHAT_LLM_PROVIDER=llama
CHAT_MAX_TOKENS=2048

# Only needed when CHAT_LLM_PROVIDER=claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Only used when CHAT_LLM_PROVIDER=llama. Needs more context than the
# validation nodes: retrieved passages + question + answer.
CHAT_MODEL_N_CTX=8192

# Weights & Biases API key — required only when WANDB_ENABLED=true (see notebook 03).
# Get yours from https://wandb.ai/authorize
WANDB_API_KEY=wandb_api_key

# Opt-in flag for notebook 03's Optuna experiment tracking. Leave unset/false
# for normal poe check / nbtest runs so they don't create W&B runs.
WANDB_ENABLED=true

# W&B project name. Defaults to "diplo-mod-1" if unset.
WANDB_PROJECT=project-name

# W&B run name. Leave unset to auto-generate one from the run config
# (e.g. "xgboost-baseline-50trials-maxdepth8") instead of wandb's random
# fancy name (e.g. "solar-glitter-42").
WANDB_RUN_NAME=

GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret

# Where Google redirects after sign-in -- the frontend's OAuth popup route (not the
# backend's own /auth/callback). Default matches the Vite dev server's default port.
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth-popup
