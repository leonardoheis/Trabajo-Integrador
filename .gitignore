# ---- ML model downloads (see README.md "Models" section for how to fetch them) ----
# Ignores everything under the root models/ directory regardless of file extension --
# *.gguf is already covered above, but a HF sentence-transformers model's
# config.json/tokenizer files/.safetensors aren't caught by any extension-based rule.
# bert_tunning_beto_v2/ and embeddings/ are tracked exceptions (below) -- everything
# else under models/ (the GGUF LLMs) stays gitignored.
models/**
!models/**/.gitkeep
!models/bert_tunning_beto_v2/
!models/bert_tunning_beto_v2/**
!models/embeddings/
!models/embeddings/**

# ---- Local document storage root (staged uploads, classified/review-queue files) ----
storage/documents/**

# ---- Generated HTML reports (one per notebook run, not source) ----
storage/reports/**

# ---- Un-ignore the main dev database (other *.db files stay ignored) ----
!data/classiflow.db

# ---- playground/samples/ is tracked on purpose: sample PDFs the notebooks in
# playground/stage1/ depend on, so a fresh clone can actually run them. ----

# ---- Claude Code / tooling (local only) ----
.claude/worktrees/
.codegraph/

# ---- Claude Code worktrees (local working directories, never committed) ----
.claude/worktrees/

